{
  "name": "@chawengburi/bobby-cli",
  "version": "0.3.2",
  "description": "Unified CLI for auth-center + session-memory — one credential store and memory client for coding agents, AI agents, openClaw, Hermes, or any other platform",
  "type": "module",
  "bin": {
    "bobby-cli": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "pretest": "tsc -p tsconfig.test.json && node -e \"require('fs').copyFileSync('package.json', '.test-build/package.json')\"",
    "test": "node --test \".test-build/test/**/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chawengburi/bobby-cli.git"
  },
  "license": "ISC",
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "inquirer": "^14.0.2"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.10",
    "@types/node": "^26.1.0",
    "typescript": "^7.0.2"
  }
}
