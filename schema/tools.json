{
  "$comment": "Agent tool-schema manifest for bobby-cli. See specs/09-spec-agent-tool-schema.md. This file is read-only data — never run as a server. Every invocation spawns a fresh `bobby-cli` subprocess; no shared connection or shared state across calls. Keep in sync with src/commands/auth.ts, src/commands/memory.ts and src/commands/uploader.ts whenever a command or flag changes. INVOCATION SAFETY (see specs/09-spec-agent-tool-schema.md § Invocation safety): `invocation` strings are illustrative only. An executor MUST build an argv array (e.g. child_process.execFile/spawn with an args array) and substitute each {placeholder} as its own argv element — never run the template through a shell or string-concatenate it, or a value containing spaces/quotes/shell metacharacters (especially {password}) can break argument boundaries or inject commands. An optional field that has no value MUST have its flag and value omitted entirely from argv — do not substitute an empty string (e.g. `--tags {tags}` with no tags becomes just `--tags`, which would incorrectly consume the next argv token). Every `code` value in this file is a member of the canonical enum defined in bobby-cli/tickets/T02-memory-outcome-classifier.md — never invent a new one here.",
  "version": "0.5.0",
  "tools": [
    {
      "name": "auth_login",
      "description": "Log in to auth-center and mint a session-memory API token, stored locally in ~/.bobby-cli/credentials.json. Only needs to be run once per machine/agent identity, not before every memory call. Prefer BOBBY_CLI_EMAIL/BOBBY_CLI_PASSWORD env vars over inline flags so the password never appears in a process list or shell history.",
      "command": [
        "auth",
        "login"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Account email. Prefer passing via BOBBY_CLI_EMAIL env var instead of this field."
          },
          "password": {
            "type": "string",
            "description": "Account password. Prefer passing via BOBBY_CLI_PASSWORD env var instead of this field — never log or echo this value."
          },
          "label": {
            "type": "string",
            "description": "Token label (default bobby-cli@<hostname>). Logging in again with the same label rotates that token instead of minting a new one. Multi-profile callers should pass one label per end user, e.g. discord-dm-<id>."
          },
          "machine": {
            "type": "boolean",
            "description": "Log in as a machine user through /auth/m2m/login instead of the human two-tier flow — machine accounts are rejected by POST /auth/tokens. A machine identity owns its own memory space (session-memory keys entries by the machine's own id), so one machine user per Discord guild keeps guild memories separate from each other and from the owner's. Rejected together with label. Provisioning only — a human runs this, never an agent on a user's behalf."
          },
          "profile": {
            "type": "string",
            "description": "Named credential profile to write instead of the default ~/.bobby-cli/credentials.json (see specs/10-spec-credential-profiles.md). Only letters, numbers, \"-\", \"_\". Omit for the default single-machine identity."
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "output_schema": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "ok": {
                "const": true
              },
              "email": {
                "type": "string"
              },
              "tenantId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "principalType": {
                "enum": [
                  "user",
                  "machine"
                ],
                "description": "Only emitted by a --machine login."
              },
              "verified": {
                "type": "boolean",
                "description": "--machine only: whether the new token was proved against session-memory before being saved. false means the check could not be made (session-memory unreachable), NOT that the token is bad — a token session-memory rejects is never saved at all."
              },
              "verifyWarning": {
                "type": "string",
                "description": "--machine only: present exactly when verified is false; why the check could not be made."
              }
            },
            "required": [
              "ok",
              "email"
            ]
          },
          {
            "type": "object",
            "properties": {
              "ok": {
                "const": false
              },
              "code": {
                "enum": [
                  "login_failed",
                  "permission_denied",
                  "network",
                  "server",
                  "usage"
                ]
              },
              "error": {
                "type": "string"
              },
              "hint": {
                "type": "string"
              }
            },
            "required": [
              "ok",
              "code",
              "error",
              "hint"
            ]
          }
        ]
      },
      "invocation": "BOBBY_CLI_EMAIL={email} BOBBY_CLI_PASSWORD={password} bobby-cli auth login --profile {profile} --json"
    },
    {
      "name": "auth_show",
      "description": "Show the current login's metadata (email, tenant, token label/id, scopes, timestamps). Never returns the raw API token. Use this to check whether auth_login is needed before calling a memory_* tool.",
      "command": [
        "auth",
        "show"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string",
            "description": "Named credential profile to read instead of the default (see specs/10-spec-credential-profiles.md). Omit for the default single-machine identity."
          }
        }
      },
      "output_schema": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "ok": {
                "const": true
              },
              "code": {
                "const": "status"
              },
              "loggedIn": {
                "const": true
              },
              "email": {
                "type": "string"
              },
              "tenantId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "principalType": {
                "enum": [
                  "user",
                  "machine"
                ]
              },
              "apiTokenLabel": {
                "type": "string"
              },
              "apiTokenId": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "null for a machine login: /auth/m2m/login returns no token record."
              },
              "scopes": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                },
                "description": "null means unknown, not none — a machine login is never told its scopes. Read principalType before treating this as a permission set."
              },
              "createdAt": {
                "type": "string"
              },
              "expiresAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "authCenterUrl": {
                "type": "string"
              },
              "sessionMemoryUrl": {
                "type": "string"
              }
            },
            "required": [
              "ok",
              "code",
              "loggedIn",
              "email"
            ]
          },
          {
            "type": "object",
            "properties": {
              "ok": {
                "const": true
              },
              "code": {
                "const": "status"
              },
              "loggedIn": {
                "const": false
              },
              "hint": {
                "type": "string"
              }
            },
            "required": [
              "ok",
              "code",
              "loggedIn",
              "hint"
            ]
          },
          {
            "type": "object",
            "properties": {
              "ok": {
                "const": false
              },
              "code": {
                "const": "usage"
              },
              "error": {
                "type": "string"
              },
              "hint": {
                "type": "string"
              }
            },
            "required": [
              "ok",
              "code",
              "error",
              "hint"
            ]
          }
        ]
      },
      "invocation": "bobby-cli auth show --profile {profile} --json"
    },
