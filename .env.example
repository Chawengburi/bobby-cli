# Copy this file to .env for repo-local dev, or to ~/.bobby-cli/.env for an
# installed/global CLI on your own device.
# .env is gitignored — never commit real credentials.
#
# Same precedence as everywhere else in bobby-cli: a real `export`ed shell env
# var always wins over repo-local .env, repo-local .env wins over
# ~/.bobby-cli/.env, and ~/.bobby-cli/.env wins over the fixed production
# default baked into src/core/config.ts.
#
# Replace these with your own dev/test deployment or a local `wrangler dev`
# URL. These are examples only and should never point at a real production
# environment in a checked-in file.
AUTH_CENTER=https://auth-center.example.com
SESSION_MEMORY_URL=https://second-brain.example.com/mcp

# `uploader search` / `uploader fetch` need NO configuration here: they go
# through auth-center at AUTH_CENTER above, which holds the document service's
# credential in its own environment. If you find yourself adding an uploader URL
# or token on this side, something has gone wrong.

# Optional — lets `bobby-cli auth login` run non-interactively (no prompt) during dev.
# BOBBY_CLI_EMAIL=you@example.com
# BOBBY_CLI_PASSWORD=your-dev-password
